# Development overrides (safe to commit — no secrets).
# Layered on top of .env when APP_ENV=development.
APP_ENV=development
LOG_LEVEL=DEBUG
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Docker Compose service hostnames (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://copilot:copilot@postgres:5432/copilot
REDIS_URL=redis://redis:6379/0

# Planner: use the deterministic fake by default so dev works with no API key.
# Set LLM_PROVIDER=anthropic and ANTHROPIC_API_KEY to use real Claude.
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=
