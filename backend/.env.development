# Development overrides (safe to commit — no secrets).
# Layered on top of .env when APP_ENV=development.
APP_ENV=development
LOG_LEVEL=DEBUG
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# Docker Compose service hostnames (see docker-compose.yml).
DATABASE_URL=postgresql+psycopg://copilot:copilot@postgres:5432/copilot
REDIS_URL=redis://redis:6379/0
