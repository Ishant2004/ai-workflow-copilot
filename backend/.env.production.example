# Production config TEMPLATE. Do NOT commit a real `.env.production`.
# In production, inject these as real environment variables via the platform
# (ECS task definition, Secrets Manager, CI). This file documents what's required.
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# Lock CORS down to the real frontend origin(s) — never "*".
CORS_ORIGINS=https://app.example.com

# Managed datastores (RDS / ElastiCache). Provide via secrets, not this file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@db-host:5432/copilot
REDIS_URL=redis://cache-host:6379/0

# LLM / planner. Secrets injected at runtime, never stored in the image or repo.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
