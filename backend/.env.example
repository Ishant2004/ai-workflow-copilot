# Template for local configuration. Copy what you need into `.env` (shared local
# defaults) and/or `.env.development` / `.env.production` (per-environment overrides).
# Load order (later wins): .env  ->  .env.<APP_ENV>  ->  real environment variables.
# Never commit real secrets. In production, inject real env vars via the platform.

# --- App ---
APP_ENV=development          # development | staging | production
APP_NAME=Workflow AI Copilot
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
DEBUG=false

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000

# CORS: comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# --- Datastores ---
# When set, the readiness probe (/health/ready) verifies connectivity to each.
DATABASE_URL=postgresql+psycopg://copilot:copilot@postgres:5432/copilot
REDIS_URL=redis://redis:6379/0

# --- LLM / planner ---
LLM_PROVIDER=anthropic          # anthropic | fake (fake needs no key)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8

# --- Tool execution ---
TOOLS_PROVIDER=fake             # fake | live (live uses real providers where configured)
TOOL_TIMEOUT_SECONDS=30
SEARCH_MAX_RESULTS=5
SEARCH_PROVIDER=fake            # fake | tavily (real web search; needs TAVILY_API_KEY, TOOLS_PROVIDER=live)
TAVILY_API_KEY=                 # https://tavily.com — free tier available
SCRAPE_MAX_CHARS=20000          # cap on text extracted by a `scrape` step (TOOLS_PROVIDER=live)
REQUIRE_REVIEW=true             # pause before side-effecting steps for human review
STEP_MAX_RETRIES=2              # retry a transiently-failing step this many times
STEP_RETRY_BACKOFF_SECONDS=0.5  # base delay for exponential backoff between retries

# --- Worker-free scheduling ---
# When set, POST /api/scheduler/tick (header X-Scheduler-Token) runs due scheduled
# workflows inline — point a free external cron (cron-job.org, GitHub Actions) at it
# instead of running Celery Beat. Unset → the endpoint is disabled.
SCHEDULER_TOKEN=                          # a long random secret; blank = disabled
SCHEDULER_TICK_WINDOW_SECONDS=300         # MUST equal your cron's interval (fire-once)

# --- Multi-agent orchestration (Step 17) ---
# The `orchestrate` step runs a researcher → summarizer → reviewer team. Each
# review round has the reviewer critique + improve the draft (more rounds = more
# LLM calls). The live team uses Claude when TOOLS_PROVIDER=live + a key is set.
AGENT_REVIEW_ROUNDS=1

# --- Feedback loop (Step 18) ---
# How many recently-approved (positively-rated) suggestions to feed the planner as
# few-shot exemplars. 0 disables the loop; higher = more prompt tokens (cost).
PLANNER_EXAMPLE_LIMIT=3

# --- Evaluation harness (Step 19) — run: python -m app.eval ---
EVAL_GROUNDING_THRESHOLD=0.5    # min fraction of a digest supported by its sources
EVAL_MIN_PASS_RATE=1.0          # CI gate: harness exits non-zero below this pass rate
EVAL_DATASET_PATH=              # optional JSON dataset; blank uses the built-in cases

# --- Output actions (Step 11); used when TOOLS_PROVIDER=live. Secrets: keep out
#     of git-tracked files — put them in .env (git-ignored) or inject at runtime.
SLACK_WEBHOOK_URL=              # https://hooks.slack.com/services/...
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Queue & scheduling (Celery + Redis) ---
RUN_ASYNC=false                 # true: POST /runs enqueues a Celery task (needs a worker)
# CELERY_BROKER_URL / CELERY_RESULT_BACKEND default to REDIS_URL when unset.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=false  # true runs tasks inline in-process (no worker)
BEAT_DISPATCH_INTERVAL_SECONDS=60

# --- RAG / embeddings ---
EMBEDDING_PROVIDER=fake         # fake = offline hashing embedder | openai = real semantic vectors
OPENAI_API_KEY=                 # required for EMBEDDING_PROVIDER=openai (Anthropic has no embeddings API)
EMBEDDING_MODEL=text-embedding-3-small  # requested at EMBEDDING_DIM (256) via the `dimensions` param
CHUNK_SIZE=1000                 # characters per chunk
CHUNK_OVERLAP=150
RAG_TOP_K=5
