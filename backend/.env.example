# Copy to .env and adjust. Never commit real secrets.
# 12-factor config: the same image runs anywhere; only env changes.

# --- App ---
APP_ENV=development          # development | staging | production
APP_NAME=Workflow AI Copilot
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000

# CORS: comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# --- Datastores (wired up in later steps) ---
# DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot
# REDIS_URL=redis://localhost:6379/0

# --- LLM (added in Step 5) ---
# ANTHROPIC_API_KEY=
