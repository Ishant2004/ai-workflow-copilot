# Template for local configuration. Copy what you need into `.env` (shared local
# defaults) and/or `.env.development` / `.env.production` (per-environment overrides).
# Load order (later wins): .env  ->  .env.<APP_ENV>  ->  real environment variables.
# Never commit real secrets. In production, inject real env vars via the platform.

# --- App ---
APP_ENV=development          # development | staging | production
APP_NAME=Workflow AI Copilot
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
DEBUG=false

# --- HTTP server ---
HOST=0.0.0.0
PORT=8000

# CORS: comma-separated origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000

# --- Datastores ---
# When set, the readiness probe (/health/ready) verifies connectivity to each.
DATABASE_URL=postgresql+psycopg://copilot:copilot@postgres:5432/copilot
REDIS_URL=redis://redis:6379/0

# --- LLM / planner ---
LLM_PROVIDER=anthropic          # anthropic | fake (fake needs no key)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
